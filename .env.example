# Web3Forms: https://web3forms.com で無料登録しアクセスキーを取得
# 受信メールは登録時に指定したアドレス
# NEXT_PUBLIC_ を付けない ─ サーバー側の Route Handler（src/app/api/contact/route.ts）
# からのみ参照し、クライアントバンドルには含めない（設計書 §7-3）。
WEB3FORMS_ACCESS_KEY=your_access_key_here

# 本番ドメイン（metadataBase・JSON-LD で使用。Phase 3 / T25 で利用）
NEXT_PUBLIC_SITE_URL=https://example.com
