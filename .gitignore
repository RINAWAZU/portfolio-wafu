# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# フォントサブセットの入力元（8MB超のフルセットTTF）。
# scripts/subset-font.sh のコメント記載URLから再取得可能なため追跡しない。
/src/fonts/src/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
